{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "node",
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@frontend/*": ["frontend/*"],
      "@backend/*": ["backend/*"]
    },
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [],
  "references": [{ "path": "./frontend" }, { "path": "./backend" }]
}
